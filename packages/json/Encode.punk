module Encode exposing
    ( encode
    , string
    , int
    , float
    , bool
    , null
    , list
    , object
    , dict
    )

{-| Turning punk values into JSON, as Elm's `Json.Encode`.

    import json.Encode as E

    E.object
        [ ("url", E.string link.url)
        , ("created", E.int link.created)
        ]
        |> E.encode 0
    -- {"url":"https://x.org","created":7}
-}

import Value

{-| The JSON text. Indent 0 puts it on one line; 4 indents each level by 4 spaces. -}
encode : Int -> Value -> Str
encode = fn indent, v ->
    Value.encode indent v

string : Str -> Value
string = fn text ->
    JString text

int : Int -> Value
int = fn n ->
    JNumber (I64.toStr n)

{-| A float. JSON has no NaN or infinity: those become `null`, as in Elm. -}
float : Float -> Value
float = fn x ->
    -- NaN and the infinities are the floats for which x - x is not 0.
    if x - x == 0.0 then JNumber (F64.toStr x) else JNull

bool : Bool -> Value
bool = fn b ->
    JBool b

null : Value
null =
    JNull

list : (a -> Value) -> List a -> Value
list = fn f, items ->
    JArray (List.map f items)

object : List (Str, Value) -> Value
object = fn fields ->
    JObject fields

{-| An object from a dictionary, keys turned into text by the first function. -}
dict : (k -> Str) -> (v -> Value) -> Dict k v -> Value
dict = fn key, f, d ->
    d
        |> Dict.toList
        |> List.map (fn (k, v) -> (key k, f v))
        |> JObject
