module Decode exposing
    ( Decoder
    , Error(..)
    , decodeString
    , decodeValue
    , errorToString
    , string
    , int
    , float
    , bool
    , null
    , value
    , list
    , keyValuePairs
    , field
    , at
    , index
    , maybe
    , nullable
    , oneOf
    , succeed
    , fail
    , map
    , map2
    , map3
    , map4
    , map5
    , andThen
    )

{-| Turning JSON into punk values, as Elm's `Json.Decode`.

    import json.Decode as D

    type alias Link = { url : Str, created : Int }

    link : D.Decoder Link
    link =
        D.map2 (fn url, created -> { url, created })
            (D.field "url" D.string)
            (D.field "created" D.int)

    D.decodeString link "{\"url\": \"https://x.org\", \"created\": 7}"
    -- Ok { url = "https://x.org", created = 7 }

A decoder is written by hand for each type: what the JSON looks like is part
of the program, and a change in it is a change you see.
-}

import Value

{-| Something that turns a JSON value into an `a`, or says why it can't. -}
type Decoder a
    = Decoder (Value -> Result a Error)

{-| What went wrong, and location: `Field "user" (Field "age" (Failure "Expecting an INT" v))`. -}
type Error
    = Field Str Error
    | Index Int Error
    | OneOf (List Error)
    | Failure Str Value
    | BadJson Str

-- Running -------------------------------------------------------------------

{-| Parses the text as JSON, then decodes it. -}
decodeString : Decoder a -> Str -> Result a Error
decodeString = fn decoder, text ->
    case Value.parse text of
        Ok v -> decodeValue decoder v
        Err message -> Err (BadJson message)

decodeValue : Decoder a -> Value -> Result a Error
decodeValue = fn (Decoder run), v ->
    run v

{-| The error as a few lines of text, for a log or a 400 response. -}
errorToString : Error -> Str
errorToString = fn error ->
    describe [] error

describe : List Str -> Error -> Str
describe = fn path, error ->
    case error of
        Field name inner -> describe (List.append ".${name}" path) inner
        Index i inner -> describe (List.append "[${String.fromInt i}]" path) inner
        OneOf [] -> "${location path}: none of the decoders could run"
        OneOf errors ->
            alternatives =
                errors
                    |> List.map (describe path)
                    |> Str.joinWith "\n  or "
            "${location path}: none of these worked:\n  ${alternatives}"
        Failure message v -> "${location path}: ${message}, but got ${Value.encode 0 v}"
        BadJson message -> "This is not valid JSON: ${message}"

location : List Str -> Str
location = fn path ->
    if List.isEmpty path then "the value" else "json${Str.joinWith "" path}"

-- Primitives ----------------------------------------------------------------

string : Decoder Str
string =
    Decoder
        (fn v ->
            case v of
                JString text -> Ok text
                _ -> Err (Failure "Expecting a STRING" v)
        )

{-| A whole number: `7`, `-3`. Not `7.5`, and not one beyond 64 bits. -}
int : Decoder Int
int =
    Decoder
        (fn v ->
            case v of
                JNumber text ->
                    case I64.fromStr text of
                        Ok n -> Ok n
                        Err _ -> Err (Failure "Expecting an INT" v)
                _ -> Err (Failure "Expecting an INT" v)
        )

float : Decoder Float
float =
    Decoder
        (fn v ->
            case v of
                JNumber text ->
                    case F64.fromStr text of
                        Ok x -> Ok x
                        Err _ -> Err (Failure "Expecting a FLOAT" v)
                _ -> Err (Failure "Expecting a FLOAT" v)
        )

bool : Decoder Bool
bool =
    Decoder
        (fn v ->
            case v of
                JBool b -> Ok b
                _ -> Err (Failure "Expecting a BOOL" v)
        )

{-| `null`, which becomes the value you give. -}
null : a -> Decoder a
null = fn result ->
    Decoder
        (fn v ->
            case v of
                JNull -> Ok result
                _ -> Err (Failure "Expecting null" v)
        )

{-| The JSON value itself, untouched. -}
value : Decoder Value
value =
    Decoder (fn v -> Ok v)

-- Structures ----------------------------------------------------------------

list : Decoder a -> Decoder (List a)
list = fn (Decoder run) ->
    Decoder
        (fn v ->
            case v of
                JArray items -> listItems run 0 items []
                _ -> Err (Failure "Expecting a LIST" v)
        )

listItems : (Value -> Result a Error) -> Int -> List Value -> List a -> Result (List a) Error
listItems = fn run, i, items, done ->
    case items of
        [] -> Ok done
        [item, ..rest] ->
            case run item of
                Ok x -> listItems run (i + 1) rest (List.append x done)
                Err e -> Err (Index i e)

{-| All fields of an object, in the order they were written. -}
keyValuePairs : Decoder a -> Decoder (List (Str, a))
keyValuePairs = fn (Decoder run) ->
    Decoder
        (fn v ->
            case v of
                JObject fields -> pairs run fields []
                _ -> Err (Failure "Expecting an OBJECT" v)
        )

pairs : (Value -> Result a Error) -> List (Str, Value) -> List (Str, a) -> Result (List (Str, a)) Error
pairs = fn run, fields, done ->
    case fields of
        [] -> Ok done
        [(name, item), ..rest] ->
            case run item of
                Ok x -> pairs run rest (List.append (name, x) done)
                Err e -> Err (Field name e)

{-| The field of an object. When the object has the field twice, the last one counts. -}
field : Str -> Decoder a -> Decoder a
field = fn name, (Decoder run) ->
    Decoder
        (fn v ->
            case v of
                JObject fields ->
                    case lookup name fields of
                        Just item -> Result.mapError (fn e -> Field name e) (run item)
                        Nothing -> Err (Failure "Expecting an OBJECT with a field named `${name}`" v)
                _ -> Err (Failure "Expecting an OBJECT with a field named `${name}`" v)
        )

lookup : Str -> List (Str, Value) -> Maybe Value
lookup = fn name, fields ->
    fold f in fields into found = Nothing
        if f.0 == name then Just f.1 else found

{-| A field inside fields: `at ["user", "name"] string`. -}
at : List Str -> Decoder a -> Decoder a
at = fn names, decoder ->
    List.foldr field decoder names

index : Int -> Decoder a -> Decoder a
index = fn i, (Decoder run) ->
    Decoder
        (fn v ->
            case v of
                JArray items ->
                    case List.get (fromInt i) items of
                        Ok item if i >= 0 -> Result.mapError (fn e -> Index i e) (run item)
                        _ -> Err (Failure "Expecting a LONGER array, with an element at index ${String.fromInt i}" v)
                _ -> Err (Failure "Expecting an ARRAY" v)
        )

{-| `Just` what the decoder gives, or `Nothing` when it fails. -}
maybe : Decoder a -> Decoder (Maybe a)
maybe = fn (Decoder run) ->
    Decoder
        (fn v ->
            case run v of
                Ok x -> Ok (Just x)
                Err _ -> Ok Nothing
        )

{-| `Nothing` for `null`, otherwise `Just` what the decoder gives. -}
nullable : Decoder a -> Decoder (Maybe a)
nullable = fn (Decoder run) ->
    Decoder
        (fn v ->
            case v of
                JNull -> Ok Nothing
                _ -> Result.map (fn x -> Just x) (run v)
        )

{-| The first decoder that works. -}
oneOf : List (Decoder a) -> Decoder a
oneOf = fn decoders ->
    Decoder (fn v -> firstOf decoders v [])

firstOf : List (Decoder a) -> Value -> List Error -> Result a Error
firstOf = fn decoders, v, errors ->
    case decoders of
        [] -> Err (OneOf errors)
        [Decoder run, ..rest] ->
            case run v of
                Ok x -> Ok x
                Err e -> firstOf rest v (List.append e errors)

-- Building ------------------------------------------------------------------

succeed : a -> Decoder a
succeed = fn x ->
    Decoder (fn _ -> Ok x)

fail : Str -> Decoder a
fail = fn message ->
    Decoder (fn v -> Err (Failure message v))

map : (a -> b) -> Decoder a -> Decoder b
map = fn f, (Decoder run) ->
    Decoder (fn v -> Result.map f (run v))

map2 : (a -> b -> c) -> Decoder a -> Decoder b -> Decoder c
map2 = fn f, (Decoder runA), (Decoder runB) ->
    Decoder
        (fn v ->
            a = try runA v
            b = try runB v
            Ok (f a b)
        )

map3 : (a -> b -> c -> d) -> Decoder a -> Decoder b -> Decoder c -> Decoder d
map3 = fn f, (Decoder runA), (Decoder runB), (Decoder runC) ->
    Decoder
        (fn v ->
            a = try runA v
            b = try runB v
            c = try runC v
            Ok (f a b c)
        )

map4 : (a -> b -> c -> d -> e) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e
map4 = fn f, (Decoder runA), (Decoder runB), (Decoder runC), (Decoder runD) ->
    Decoder
        (fn v ->
            a = try runA v
            b = try runB v
            c = try runC v
            d = try runD v
            Ok (f a b c d)
        )

map5 : (a -> b -> c -> d -> e -> f) -> Decoder a -> Decoder b -> Decoder c -> Decoder d -> Decoder e -> Decoder f
map5 = fn f, (Decoder runA), (Decoder runB), (Decoder runC), (Decoder runD), (Decoder runE) ->
    Decoder
        (fn v ->
            a = try runA v
            b = try runB v
            c = try runC v
            d = try runD v
            e = try runE v
            Ok (f a b c d e)
        )

andThen : (a -> Decoder b) -> Decoder a -> Decoder b
andThen = fn f, (Decoder run) ->
    Decoder
        (fn v ->
            a = try run v
            decodeValue (f a) v
        )
