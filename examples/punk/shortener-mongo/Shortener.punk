app [handle!] { Platform: platform "../../../platforms/server/main.roc", Json: "../../../packages/json/main.roc" }

import Platform.Http exposing [Request, Response]
import Platform.Clock
import Platform.Random
import Platform.Config
import Platform.Log
import Platform.Mongo
import Platform.Bson
import Platform.Doc
import Platform.Filter
import Platform.Update
import Json.Decode as D

{-| A link shortener: ambit's `apps/shortener`, in punk, with its links in
Mongo instead of a key-value store. Each link is one document of the
collection `links`, with the link's id as its `_id`.

- `POST /links` with a URL as body: creates a short link, 201 with the short URL.
- `GET /<id>`: 302 to the URL, 404 if unknown, 410 once expired.
- `GET /stats`: how many links there are, and the three most visited
  (not in ambit's shortener: it shows `Mongo.update!`, sorting and counting).

The app can only do what the platform hands it: a clock, randomness, a
database, its configuration and a log. Which database, and which of its
collections the app may use, is up to the wiring.
-}

-- Configuration, from the wiring: `{"baseUrl": "https://s.test", "ttlSeconds": 3600}`
type alias Settings =
    { baseUrl : Str
    , ttlSeconds : Int
    }

settings : D.Decoder Settings
settings =
    D.map2 (fn baseUrl, ttlSeconds -> { baseUrl, ttlSeconds })
        (D.field "baseUrl" D.string)
        (D.field "ttlSeconds" D.int)

-- A stored link: a document of the collection `links`.
type alias Link =
    { id : Str
    , url : Str
    , created : Int
    }

-- The links, one document each, with the id of the link as the document's `_id`.
links : Mongo.Collection
links =
    Mongo.collection "links"

linkDecoder : Doc.Decoder Link
linkDecoder =
    Doc.map3 (fn id, url, created -> { id, url, created })
        (Doc.field "_id" Doc.text)
        (Doc.field "url" Doc.text)
        (Doc.field "created" Doc.int)

linkDocument : Link -> Bson.Value
linkDocument = fn link ->
    Bson.object
        [ ("_id", Bson.text link.id)
        , ("url", Bson.text link.url)
        , ("created", Bson.int link.created)
        ]

findLink! : Str => Result (Maybe Link) _
findLink! = fn id ->
    links
        |> Mongo.find (byId id)
        |> Mongo.first! linkDecoder

byId : Str -> Filter
byId = fn id ->
    Filter.equals "_id" (Bson.text id)

-- One more visit of the link; a link without visits gets its first. When
-- the count fails, the redirect still works.
countVisit! : Str => ()
countVisit! = fn id ->
    case Mongo.update! (byId id) [Update.increment "visits" 1] links of
        Ok _ -> ()
        Err (MongoErr problem) -> Log.warn! "the visit of ${id} was not counted (${problem.code}): ${problem.message}"
        Err (DocErr problem) -> Log.warn! "the visit of ${id} was not counted: ${problem}"

-- How many links there are, and the most visited ones.
type alias Visits =
    { id : Str
    , visits : Int
    }

visitsDecoder : Doc.Decoder Visits
visitsDecoder =
    Doc.map2 (fn id, visits -> { id, visits })
        (Doc.field "_id" Doc.text)
        (Doc.map (Maybe.withDefault 0) (Doc.optionalField "visits" Doc.int))

-- `GET /stats`: the number of links and the three most visited, one per line.
stats! : Settings => Result Response _
stats! = fn config ->
    total = try (links |> Mongo.find Filter.everything |> Mongo.count!)
    top =
        try
            (links
                |> Mongo.find (Filter.atLeast "visits" (Bson.int 1))
                |> Mongo.sortBy "_id"
                |> Mongo.sortByDescending "visits"
                |> Mongo.take 3
                |> Mongo.all! visitsDecoder
            )
    lines = List.map (fn v -> "${config.baseUrl}/${v.id} ${String.fromInt v.visits}\n") top
    Ok (text 200 ("links: ${String.fromInt total}\n" ++ String.concat lines))

-- Adds the link, unless its id is taken: then it gives `False`.
insertLink! : Link => Result Bool _
insertLink! = fn link ->
    Mongo.insertIfNew! (linkDocument link) links

maxUrl : U64
maxUrl = 2048

idLength : Int
idLength = 7

idAttempts : Int
idAttempts = 5

handle! : Request => Response
handle! = fn req ->
    case D.decodeString settings (Config.text! ()) of
        Err problem ->
            Log.error! "bad configuration: ${D.errorToString problem}"
            text 500 "bad configuration\n"
        Ok config ->
            id = Str.dropPrefix "/" req.path
            result =
                case req.method of
                    "POST" if req.path == "/links" -> create! config req.body
                    "GET" if req.path == "/stats" -> stats! config
                    "GET" if isId id -> resolve! config id
                    _ -> Ok (text 404 "not found\n")
            case result of
                Ok response -> response
                Err (MongoErr problem) ->
                    Log.error! "storage failed (${problem.code}): ${problem.message}"
                    text 503 "storage unavailable\n"
                Err (DocErr problem) ->
                    Log.error! "a stored link doesn't fit: ${problem}"
                    text 500 "internal error\n"

create! : Settings -> List U8 => Result Response _
create! = fn config, body ->
    case validUrl body of
        Nothing -> Ok (text 400 "body must be an http(s) URL\n")
        Just url ->
            case try store! url idAttempts of
                Nothing -> Ok (text 503 "no free id, try again\n")
                Just id ->
                    Log.info! "link created: ${id}"
                    short = "${config.baseUrl}/${id}"
                    Ok (withHeader "location" short (text 201 "${short}\n"))

resolve! : Settings -> Str => Result Response _
resolve! = fn config, id ->
    case try findLink! id of
        Nothing -> Ok (text 404 "not found\n")
        Just link ->
            if unixSeconds (Clock.now! ()) >= link.created + config.ttlSeconds then
                Ok (text 410 "expired\n")
            else
                countVisit! id
                -- The URL was checked to be a valid header value when it was stored.
                Ok (withHeader "location" link.url (text 302 ""))

-- Stores the URL under a fresh id; `Nothing` when no free id was found.
store! : Str -> Int => Result (Maybe Str) _
store! = fn url, attemptsLeft ->
    if attemptsLeft <= 0 then
        Ok Nothing
    else
        id = newId (Random.u64! ())
        link = { id, url, created = unixSeconds (Clock.now! ()) }
        if try insertLink! link then
            Ok (Just id)
        else
            store! url (attemptsLeft - 1)

alphabet : List U8
alphabet =
    Str.toUtf8 "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz"

-- Seven characters from the alphabet, the lowest digits of `n` in base 62 first.
newId : U64 -> Str
newId = fn n ->
    idChars n idLength []
        |> Str.fromUtf8
        |> Result.withDefault ""

idChars : U64 -> Int -> List U8 -> List U8
idChars = fn n, left, chars ->
    if left <= 0 then
        chars
    else
        char =
            alphabet
                |> List.get (n % 62)
                |> Result.withDefault '0'
        idChars (n // 62) (left - 1) (List.append char chars)

isId : Str -> Bool
isId = fn s ->
    bytes = Str.toUtf8 s
    List.length bytes == idLength && List.all isAlphanumeric bytes

isAlphanumeric : U8 -> Bool
isAlphanumeric = fn b ->
    (b >= '0' && b <= '9') || (b >= 'A' && b <= 'Z') || (b >= 'a' && b <= 'z')

-- An http(s) URL that fits in a header: no line breaks, nothing outside printable ASCII.
validUrl : List U8 -> Maybe Str
validUrl = fn body ->
    case Str.fromUtf8 body of
        Err _ -> Nothing
        Ok raw ->
            url = String.trim raw
            bytes = Str.toUtf8 url
            fits = List.len bytes <= maxUrl && List.all isHeaderByte bytes
            web = String.startsWith "https://" url || String.startsWith "http://" url
            if fits && web then Just url else Nothing

isHeaderByte : U8 -> Bool
isHeaderByte = fn b ->
    (b >= 32 && b < 127) || b == '\t'

unixSeconds : I64 -> Int
unixSeconds = fn millis ->
    millis // 1000

text : U16 -> Str -> Response
text = fn status, body ->
    { status
    , headers = [("content-type", "text/plain; charset=utf-8")]
    , body = Str.toUtf8 body
    }

withHeader : Str -> Str -> Response -> Response
withHeader = fn name, value, response ->
    { response | headers = List.append (name, value) response.headers }
