app [handle!] { pf: platform "../../../platforms/server/main.roc" }

import pf.Http exposing [Request, Response]
import pf.Db
import pf.Random
import pf.Log

{-| Notes, each of one user, in Postgres. Who may see and change a note is
the table's policy, and the database itself keeps to it: punk turns each
policy into a row-level security policy (`schema.sql`), and runs each query
as the user of the request (`Db.runAs!`).

- `POST /notes` with the text as body: makes a note of the user, 201 with its id.
- `GET /notes`: the notes the user may read, one per line: `id public body`.
- `POST /notes/<id>/publish`: makes the note public, 404 if it isn't the user's.
- `POST /notes/<id>/pin`: pins the note and unpins the user's others, 404 if
  it isn't the user's (and then the others keep their pin).
- `DELETE /notes/<id>`: removes the note, 404 if it isn't the user's or is pinned.
- `PUT /me` with a name as body: the name of the user, 201 the first time.
- `GET /public`: the public notes of the users with a name, by name and then
  by text, one per line: `name: body`.

The user comes from the header `x-user`, which a proxy in front of the app
sets once it has signed the user in. Without it the user is nobody, who only
reads the public notes and writes none.
-}

type alias Note =
    { id : Str
    , owner : Str
    , body : Str
    , public : Bool
    , pinned : Bool
    }

-- Everyone reads the public notes and their own; only the owner changes a
-- note, and removes it when it isn't pinned.
table notes : Note
    key id
    read fn user, note -> note.public || note.owner == user.id
    insert fn user, note -> note.owner == user.id
    update fn user, note -> note.owner == user.id
    delete fn user, note -> note.owner == user.id && not note.pinned

-- In version 2 of schema.sql `text` became `body`, and notes can be pinned.
-- Its migration was `fn old -> { old | body = old.text, pinned = False }`;
-- once schema.sql has a version, the migrate that made it goes.

type alias Person =
    { id : Str
    , name : Str
    }

-- The names of the users: everyone reads them, each user writes their own.
table people : Person
    key id
    read everyone
    insert fn user, person -> person.id == user.id
    update fn user, person -> person.id == user.id
    delete nobody

type alias User =
    { id : Str
    }

-- Every note: the policy leaves out the ones the user may not read.
readable : Db.Query (List Note)
readable =
    notes |> Db.all

publish : Str -> Db.Query Int
publish = fn id ->
    notes
        |> Db.filter (fn note -> note.id == id)
        |> Db.update (fn note -> { note | public = True })

pin : Str -> Db.Query Int
pin = fn id ->
    notes
        |> Db.filter (fn note -> note.id == id)
        |> Db.update (fn note -> { note | pinned = True })

-- The pins of the user's notes go: `pinOnly!` runs it before `pin`.
unpinAll : Str -> Db.Query Int
unpinAll = fn owner ->
    notes
        |> Db.filter (fn note -> note.owner == owner && note.pinned)
        |> Db.update (fn note -> { note | pinned = False })

rename : Str -> Str -> Db.Query Int
rename = fn id, newName ->
    people
        |> Db.filter (fn person -> person.id == id)
        |> Db.update (fn person -> { person | name = newName })

-- The public notes with the names of who wrote them, by name and then by
-- text, at most 20: a join, still one SQL statement.
publicNotes : Db.Query (List { name : Str, body : Str })
publicNotes =
    notes
        |> Db.join people (fn note, person -> note.owner == person.id)
        |> Db.filter (fn note, _ -> note.public)
        |> Db.sortBy (fn note, _ -> note.body)
        |> Db.sortBy (fn _, person -> person.name)
        |> Db.take 20
        |> Db.map (fn note, person -> { name = person.name, body = note.body })
        |> Db.all

remove : Str -> Db.Query Int
remove = fn id ->
    notes
        |> Db.filter (fn note -> note.id == id)
        |> Db.delete

handle! : Request => Response
handle! = fn req ->
    user = { id = header "x-user" req }
    case route! user req of
        Ok response -> response
        Err (PgErr problem) ->
            -- 42501: a policy refused the row.
            if problem.code == "42501" then
                text 403 "not allowed\n"
            else
                Log.error! "storage failed (${problem.code}): ${problem.message}"
                text 503 "storage unavailable\n"
        Err (RowErr problem) ->
            Log.error! "a stored note doesn't fit: ${problem}"
            text 500 "internal error\n"
        Err NotFound ->
            text 404 "not found\n"

route! : User -> Request => Result Response _
route! = fn user, req ->
    case (req.method, Str.splitOn "/" req.path) of
        ("POST", ["", "notes"]) -> add! user req.body
        ("GET", ["", "notes"]) -> list! user
        ("POST", ["", "notes", id, "publish"]) -> changed (try Db.runAs! user (publish id))
        ("POST", ["", "notes", id, "pin"]) -> Db.transactionAs! user (fn _ -> pinOnly! user id)
        ("DELETE", ["", "notes", id]) -> changed (try Db.runAs! user (remove id))
        ("PUT", ["", "me"]) -> setName! user req.body
        ("GET", ["", "public"]) -> listPublic! user
        _ -> Ok (text 404 "not found\n")

add! : User -> List U8 => Result Response _
add! = fn user, body ->
    case Str.fromUtf8 body of
        Err _ -> Ok (text 400 "a note is text\n")
        Ok noteText ->
            id = "n${U64.toStr (Random.u64! ())}"
            note = { id, owner = user.id, body = noteText, public = False, pinned = False }
            _ = try Db.runAs! user (Db.insert note notes)
            Ok (text 201 "${id}\n")

list! : User => Result Response _
list! = fn user ->
    found = try Db.runAs! user readable
    lines =
        found
            |> List.map (fn note -> "${note.id} ${if note.public then "public" else "private"} ${note.body}\n")
            |> Str.joinWith ""
    Ok (text 200 lines)

-- One pinned note per user. Both changes are in one transaction: when the
-- note isn't there, `Err NotFound` rolls back the unpinning too.
pinOnly! : User -> Str => Result Response _
pinOnly! = fn user, id ->
    _ = try Db.runAs! user (unpinAll user.id)
    count = try Db.runAs! user (pin id)
    if count == 0 then
        Err NotFound
    else
        Ok (text 200 "ok\n")

setName! : User -> List U8 => Result Response _
setName! = fn user, body ->
    case Str.fromUtf8 body of
        Err _ -> Ok (text 400 "a name is text\n")
        Ok newName -> Db.transactionAs! user (fn _ -> saveName! user newName)

-- A new name, or a change of the name, in one transaction. Two requests at
-- once can still both find no name: then the second insert fails on the key.
saveName! : User -> Str => Result Response _
saveName! = fn user, newName ->
    count = try Db.runAs! user (rename user.id newName)
    if count == 0 then
        _ = try Db.runAs! user (Db.insert { id = user.id, name = newName } people)
        Ok (text 201 "ok\n")
    else
        Ok (text 200 "ok\n")

listPublic! : User => Result Response _
listPublic! = fn user ->
    found = try Db.runAs! user publicNotes
    lines =
        found
            |> List.map (fn note -> "${note.name}: ${note.body}\n")
            |> Str.joinWith ""
    Ok (text 200 lines)

-- A change of one row: 200, or 404 when the policy left the row out.
changed : Int -> Result Response _
changed = fn count ->
    if count == 0 then
        Ok (text 404 "not found\n")
    else
        Ok (text 200 "ok\n")

-- The value of the header `name`, "" when the request has none.
header : Str -> Request -> Str
header = fn name, req ->
    req.headers
        |> List.filter (fn (key, _) -> key == name)
        |> List.head
        |> Maybe.map (fn (_, value) -> value)
        |> Maybe.withDefault ""

text : U16 -> Str -> Response
text = fn status, body ->
    { status
    , headers = [("content-type", "text/plain; charset=utf-8")]
    , body = Str.toUtf8 body
    }
