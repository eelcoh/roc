app [handle!] { pf: platform "../../../platforms/server/main.roc" }

import pf.Http exposing [Request, Response]
import pf.Db
import pf.Random
import pf.Log

{-| Notes, each of one user, in Postgres. Who may see and change a note is
the table's policy, and the database itself keeps to it: punk turns each
policy into a row-level security policy (`schema.sql`), and runs each query
as the user of the request (`Db.runAs!`).

- `POST /notes` with the text as body: makes a note of the user, 201 with its id.
- `GET /notes`: the notes the user may read, one per line: `id public text`.
- `POST /notes/<id>/publish`: makes the note public, 404 if it isn't the user's.
- `DELETE /notes/<id>`: removes the note, 404 if it isn't the user's.

The user comes from the header `x-user`, which a proxy in front of the app
sets once it has signed the user in. Without it the user is nobody, who only
reads the public notes and writes none.
-}

type alias Note =
    { id : Str
    , owner : Str
    , text : Str
    , public : Bool
    }

-- Everyone reads the public notes and their own; only the owner changes or
-- removes a note.
table notes : Note
    key id
    read fn user, note -> note.public || note.owner == user.id
    insert fn user, note -> note.owner == user.id
    update fn user, note -> note.owner == user.id
    delete fn user, note -> note.owner == user.id

type alias User =
    { id : Str
    }

-- Every note: the policy leaves out the ones the user may not read.
readable : Db.Query (List Note)
readable =
    notes |> Db.all

publish : Str -> Db.Query Int
publish = fn id ->
    notes
        |> Db.filter (fn note -> note.id == id)
        |> Db.update (fn note -> { note | public = True })

remove : Str -> Db.Query Int
remove = fn id ->
    notes
        |> Db.filter (fn note -> note.id == id)
        |> Db.delete

handle! : Request => Response
handle! = fn req ->
    user = { id = header "x-user" req }
    case route! user req of
        Ok response -> response
        Err (PgErr problem) ->
            -- 42501: a policy refused the row.
            if problem.code == "42501" then
                text 403 "not allowed\n"
            else
                Log.error! "storage failed (${problem.code}): ${problem.message}"
                text 503 "storage unavailable\n"
        Err (RowErr problem) ->
            Log.error! "a stored note doesn't fit: ${problem}"
            text 500 "internal error\n"

route! : User -> Request => Result Response _
route! = fn user, req ->
    case (req.method, Str.splitOn "/" req.path) of
        ("POST", ["", "notes"]) -> add! user req.body
        ("GET", ["", "notes"]) -> list! user
        ("POST", ["", "notes", id, "publish"]) -> changed (try Db.runAs! user (publish id))
        ("DELETE", ["", "notes", id]) -> changed (try Db.runAs! user (remove id))
        _ -> Ok (text 404 "not found\n")

add! : User -> List U8 => Result Response _
add! = fn user, body ->
    case Str.fromUtf8 body of
        Err _ -> Ok (text 400 "a note is text\n")
        Ok noteText ->
            id = "n${U64.toStr (Random.u64! ())}"
            note = { id, owner = user.id, text = noteText, public = False }
            _ = try Db.runAs! user (Db.insert note notes)
            Ok (text 201 "${id}\n")

list! : User => Result Response _
list! = fn user ->
    found = try Db.runAs! user readable
    lines =
        found
            |> List.map (fn note -> "${note.id} ${if note.public then "public" else "private"} ${note.text}\n")
            |> Str.joinWith ""
    Ok (text 200 lines)

-- A change of one row: 200, or 404 when the policy left the row out.
changed : Int -> Result Response _
changed = fn count ->
    if count == 0 then
        Ok (text 404 "not found\n")
    else
        Ok (text 200 "ok\n")

-- The value of the header `name`, "" when the request has none.
header : Str -> Request -> Str
header = fn name, req ->
    req.headers
        |> List.filter (fn (key, _) -> key == name)
        |> List.head
        |> Maybe.map (fn (_, value) -> value)
        |> Maybe.withDefault ""

text : U16 -> Str -> Response
text = fn status, body ->
    { status
    , headers = [("content-type", "text/plain; charset=utf-8")]
    , body = Str.toUtf8 body
    }
