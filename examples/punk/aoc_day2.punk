app [main!] { pf: platform "../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Advent of Code 2025, day 2, in punkroc.
Ported from test/fx/aoc_day2.roc.
-}

demoInput = "11-22,95-115,998-1012,1188511880-1188511890,222220-222224,1698522-1698528,446443-446449,38593856-38593862,565653-565659,824824821-824824827,2121212118-2121212124"

main! = fn () ->
    case run! () of
        Ok _ -> {}
        Err _ -> {}

run! = fn () ->
    part1Demo = part1! demoInput?
    Stdout.line! "-----------"
    part2Demo = part2! demoInput?
    Stdout.line! "-----------"
    Stdout.line! "Part 1 (demo): ${U64.toStr part1Demo}"
    Stdout.line! "Part 2 (demo): ${U64.toStr part2Demo}"
    Ok {}

part1! : Str => Try U64 _
part1! = fn input ->
    solve input findInvalidInRangePart1

part2! : Str => Try U64 _
part2! = fn input ->
    solve input findInvalidInRangePart2

solve = fn input, findInvalid ->
    var allInvalid = []
    for rangeStr in Str.splitOn (Str.trim input) ","
        range = parseRange rangeStr?
        var rangeInvalid = []

        -- Split by digit count and process each sub-range
        for subRange in splitByDigitCount range
            rangeInvalid = List.concat rangeInvalid (findInvalid subRange)

        allInvalid = List.concat allInvalid (dedup rangeInvalid)

    Ok (List.fold allInvalid 0 (fn acc, n -> acc + n))

-- Ideally we use a Set, but it's not available yet.
dedup = fn list ->
    var deduped = []
    for item in list
        if not (List.contains deduped item) then
            deduped = List.append deduped item
    deduped

parseRange : Str -> Try (U64, U64) _
parseRange = fn rangeStr ->
    case Str.splitOn rangeStr "-" of
        [a, b] -> Ok (U64.fromStr a?, U64.fromStr b?)
        _ -> Err InvalidRangeFormat

-- Split a range into sub-ranges where all numbers have the same digit count
splitByDigitCount : (U64, U64) -> List (U64, U64)
splitByDigitCount = fn (start, end) ->
    startDigits = countDigits start
    endDigits = countDigits end

    if startDigits == endDigits then
        [(start, end)]
    else
        -- Find the boundary: the largest number with startDigits digits
        boundary = pow 10 startDigits - 1
        List.append (splitByDigitCount (boundary + 1, end)) (start, boundary)

countDigits : U64 -> U64
countDigits = fn n ->
    if n == 0 then
        return 1

    var count = 0
    var num = n
    while num > 0
        count = count + 1
        num = num // 10
    count

pow : U64, U64 -> U64
pow = fn base, exp ->
    var result = 1
    var b = base
    var e = exp
    while e > 0
        if e % 2 == 1 then
            result = result * b
        b = b * b
        e = e // 2
    result

-- Part 1: numbers that are exactly one slice repeated twice
findInvalidInRangePart1 : (U64, U64) -> List U64
findInvalidInRangePart1 = fn (start, end) ->
    digitCount = countDigits start
    divisors = if digitCount % 2 == 0 then [digitCount // 2] else []
    collect divisors digitCount start end

-- Part 2: numbers that show any repeating pattern of digits
findInvalidInRangePart2 : (U64, U64) -> List U64
findInvalidInRangePart2 = fn (start, end) ->
    digitCount = countDigits start
    collect (getDivisors digitCount) digitCount start end

collect = fn divisors, digitCount, start, end ->
    var allInvalid = []
    for divisor in divisors
        allInvalid = List.concat allInvalid (generateRepeating divisor digitCount start end)
    allInvalid

getDivisors : U64 -> List U64
getDivisors = fn n ->
    var divisors = []
    var d = 1
    while d <= n // 2
        if n % d == 0 then
            divisors = List.append divisors d
        d = d + 1
    divisors

generateRepeating : U64, U64, U64, U64 -> List U64
generateRepeating = fn patternLen, digitCount, rangeStart, rangeEnd ->
    multiplier = (pow 10 digitCount - 1) // (pow 10 patternLen - 1)
    patternMin = rangeStart // pow 10 (digitCount - patternLen)
    patternMax = rangeEnd // pow 10 (digitCount - patternLen)

    var results = []
    var pattern = patternMin
    while pattern <= patternMax
        repeated = pattern * multiplier
        if rangeStart <= repeated && repeated <= rangeEnd then
            results = List.append results repeated
        pattern = pattern + 1
    results
