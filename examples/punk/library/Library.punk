app [Model, Msg, main] { Platform: platform "../../../platforms/tui/main.roc", Json: "../../../packages/json/main.roc" }

import Platform.Tui exposing [Event]
import Platform.Cmd
import Platform.View
import Platform.File
import Json.Decode as D

{-| The library view of crossload (github.com/eelcoh/crossload), in punk.

The books and where they are come from `library.json` in the folder the
wiring gives the app. The list shows, per book, whether it is marked and
whether it is on the computer (L), the Kobo (K) and the CrossPoint reader
(C). Keys as in crossload:

- arrows or j/k, Home/End, Page Up/Down: move
- Space: mark or unmark the highlighted book; a: mark all books shown, or
  clear them when they are all marked already
- s: sort by title, then author, then series
- /: search titles, authors and series (`author:`, `title:` and `series:`
  search one field); Esc or Enter leaves the search, Ctrl+U clears it
- r: read the library again; q or Esc: quit

Marked books stay marked when a search hides them.
-}

main =
    { init = init, update = update, view = view }

-- MODEL

type alias Book =
    { id : Str
    , title : Str
    , author : Str
    , series : Str
    , local : Bool
    , kobo : Bool
    , crossPoint : Bool
    }

type Sort
    = ByTitle
    | ByAuthor
    | BySeries

type alias Model =
    { books : List Book
    , sort : Sort
    , selected : Int
    , marked : List Str
    , query : Str
    , searching : Bool
    , status : Str
    , width : Int
    }

init : (Model, Cmd Msg)
init =
    ( { books = []
        , sort = ByTitle
        , selected = 0
        , marked = []
        , query = ""
        , searching = False
        , status = "Reading the library…"
        , width = 80
        }
    , File.read "library.json" Loaded
    )

-- UPDATE

type Msg
    = Loaded (Result Str Str)

update : Event Msg -> Model -> (Model, Cmd Msg)
update = fn event, model ->
    case event of
        Msg (Loaded (Ok text)) ->
            case D.decodeString (D.list book) text of
                Ok books ->
                    (keepSelection model (sortBooks model.sort books), Cmd.none)

                Err problem ->
                    ({ model | status = "The library can't be read: ${D.errorToString problem}" }, Cmd.none)

        Msg (Loaded (Err why)) ->
            ({ model | status = "The library can't be read: ${why}" }, Cmd.none)

        Resize width _ ->
            ({ model | width = width }, Cmd.none)

        Paste text ->
            if model.searching then
                (search (model.query ++ text) model, Cmd.none)
            else
                (model, Cmd.none)

        Key key ->
            if model.searching then
                searchKey key model
            else
                listKey key model

listKey : Tui.Key -> Model -> (Model, Cmd Msg)
listKey = fn key, model ->
    case key of
        Char "q" ->
            (model, Cmd.quit)

        Esc ->
            (model, Cmd.quit)

        Ctrl "c" ->
            (model, Cmd.quit)

        Char "/" ->
            ({ model | searching = True }, Cmd.none)

        Char "s" ->
            (resort (nextSort model.sort) model, Cmd.none)

        Char " " ->
            (toggle model, Cmd.none)

        Char "a" ->
            (markShown model, Cmd.none)

        Char "r" ->
            ({ model | status = "Reading the library…" }, File.read "library.json" Loaded)

        _ ->
            (move key model, Cmd.none)

searchKey : Tui.Key -> Model -> (Model, Cmd Msg)
searchKey = fn key, model ->
    case key of
        Esc ->
            ({ model | searching = False }, Cmd.none)

        Enter ->
            ({ model | searching = False }, Cmd.none)

        Ctrl "c" ->
            (model, Cmd.quit)

        Ctrl "u" ->
            (search "" model, Cmd.none)

        Backspace ->
            (search (dropLast model.query) model, Cmd.none)

        Char c ->
            (search (model.query ++ c) model, Cmd.none)

        _ ->
            (move key model, Cmd.none)

move : Tui.Key -> Model -> Model
move = fn key, model ->
    last = List.length (shown model) - 1
    to =
        case key of
            Down -> model.selected + 1
            Char "j" -> model.selected + 1
            Up -> model.selected - 1
            Char "k" -> model.selected - 1
            Home -> 0
            End -> last
            PageDown -> model.selected + 10
            PageUp -> model.selected - 10
            _ -> model.selected
    { model | selected = max 0 (min last to) }

search : Str -> Model -> Model
search = fn query, model ->
    { model | query = query, selected = 0 }

{-| Sorting keeps the highlighted book highlighted, wherever it lands. -}
resort : Sort -> Model -> Model
resort = fn sort, model ->
    keepSelection { model | sort = sort } (sortBooks sort model.books)

keepSelection : Model -> List Book -> Model
keepSelection = fn model, books ->
    before = highlighted model
    next = { model | books = books, status = "" }
    case before of
        Just old ->
            { next | selected = Maybe.withDefault 0 (indexOf (fn b -> b.id == old.id) (shown next)) }

        Nothing ->
            { next | selected = 0 }

toggle : Model -> Model
toggle = fn model ->
    case highlighted model of
        Just b ->
            if List.member b.id model.marked then
                { model | marked = List.filter (fn id -> id /= b.id) model.marked }
            else
                { model | marked = model.marked ++ [b.id] }

        Nothing ->
            model

{-| Marks every book shown; when they are all marked already, unmarks them. -}
markShown : Model -> Model
markShown = fn model ->
    ids = List.map .id (shown model)
    allMarked = not (List.isEmpty ids) && List.all (fn id -> List.member id model.marked) ids
    if allMarked then
        { model | marked = List.filter (fn id -> not (List.member id ids)) model.marked }
    else
        { model | marked = model.marked ++ List.filter (fn id -> not (List.member id model.marked)) ids }

-- QUERIES

{-| The books the search lets through, in the order of the list. -}
shown : Model -> List Book
shown = fn model ->
    query = String.toLower model.query
    List.filter (matches query) model.books

matches : Str -> Book -> Bool
matches = fn query, b ->
    everything = String.toLower "${b.title} ${b.author} ${b.series}"
    case Str.splitFirst ":" query of
        Ok parts ->
            term = String.trimLeft parts.after
            case parts.before of
                "author" -> String.contains term (String.toLower b.author)
                "title" -> String.contains term (String.toLower b.title)
                "series" -> String.contains term (String.toLower b.series)
                _ -> String.contains query everything

        Err _ ->
            String.contains query everything

highlighted : Model -> Maybe Book
highlighted = fn model ->
    shown model
        |> List.drop model.selected
        |> List.head

{-| By the sort's field, then by title; letter case doesn't count. -}
sortBooks : Sort -> List Book -> List Book
sortBooks = fn sort, books ->
    List.sortWith (fn a, b -> byKey sort a b) books

byKey : Sort -> Book -> Book -> Order
byKey = fn sort, a, b ->
    byTitle = compareText a.title b.title
    first =
        case sort of
            ByTitle -> EQ
            ByAuthor -> compareText a.author b.author
            BySeries -> compareText a.series b.series
    if first == EQ then byTitle else first

nextSort : Sort -> Sort
nextSort = fn sort ->
    case sort of
        ByTitle -> ByAuthor
        ByAuthor -> BySeries
        BySeries -> ByTitle

sortLabel : Sort -> Str
sortLabel = fn sort ->
    case sort of
        ByTitle -> "title ↑"
        ByAuthor -> "author ↑"
        BySeries -> "series ↑"

-- VIEW

view : Model -> View
view = fn model ->
    books = shown model
    total = List.length model.books
    count = List.length books
    View.column
        [ View.height 1 (View.paragraph [[View.span [View.bold] "Crossload", View.plain " · Books"]])
        , View.height 1 (View.paragraph [infoLine model count total])
        , View.block (libraryTitle count total) (View.list model.selected (List.map (bookLine model) books))
        , View.height 1 (View.paragraph [[View.span [View.fg Yellow] model.status]])
        , View.height 1 (View.paragraph [[View.span [View.dim] "↑↓ move · Space mark · a all · s sort · / search · q quit"]])
        ]

infoLine : Model -> Int -> Int -> View.Line
infoLine = fn model, count, total ->
    if model.searching then
        [View.span [View.fg Cyan] "/", View.plain model.query, View.span [View.fg Cyan] "▏"]
    else
        matching = if String.isEmpty model.query then "" else " · matching ${model.query}"
        marked = List.length model.marked
        [ View.span [View.bold] "All books"
        , View.plain "${matching}  ${String.fromInt count} of ${String.fromInt total} · ${sortLabel model.sort}"
        ]
            ++ (if marked > 0 then [View.span [View.fg Green] "  ✓ ${String.fromInt marked} marked"] else [])

libraryTitle : Int -> Int -> Str
libraryTitle = fn count, total ->
    if count == total then
        " Library · ${String.fromInt total} "
    else
        " Library · ${String.fromInt count} of ${String.fromInt total} "

bookLine : Model -> Book -> View.Line
bookLine = fn model, b ->
    -- The frame takes two columns, the mark and the places eight.
    room = model.width - 10
    titleWidth = max 10 (room * 55 // 100)
    [ if List.member b.id model.marked then View.span [View.fg Green] "✓" else View.plain " "
    , View.plain " "
    , presence b.local
    , View.plain " "
    , presence b.kobo
    , View.plain " "
    , presence b.crossPoint
    , View.plain " "
    , View.plain (fit (titleWidth - 1) b.title)
    , View.plain " "
    , View.span [View.dim] (fit (room - titleWidth) b.author)
    ]

presence : Bool -> View.Span
presence = fn here ->
    if here then View.span [View.fg Green] "●" else View.plain "·"

-- DECODING

{-| A book of `library.json`: `{ "id": "books/dune.epub", "title": "Dune",
"author": "Frank Herbert", "series": "Dune 1", "on": ["local", "kobo"] }`.
The series may be left out; places are `local`, `kobo` and `crosspoint`.
-}
book : D.Decoder Book
book =
    D.map5 (fn id, title, author, series, on -> { id, title, author, series, local = List.member "local" on, kobo = List.member "kobo" on, crossPoint = List.member "crosspoint" on })
        (D.field "id" D.string)
        (D.field "title" D.string)
        (D.field "author" D.string)
        (D.oneOf [D.field "series" D.string, D.succeed ""])
        (D.field "on" (D.list D.string))

-- TEXT

{-| Text in alphabetical order, letter case aside. (`compare` doesn't take
`Str` in punk yet: Roc's strings have no order.)
-}
compareText : Str -> Str -> Order
compareText = fn a, b ->
    compareBytes (Str.toUtf8 (String.toLower a)) (Str.toUtf8 (String.toLower b))

compareBytes : List U8 -> List U8 -> Order
compareBytes = fn a, b ->
    case (a, b) of
        ([], []) -> EQ
        ([], _) -> LT
        (_, []) -> GT
        ([x, ..xs], [y, ..ys]) -> if x == y then compareBytes xs ys else compare x y

{-| The text in exactly this many columns: cut with `…`, or padded. -}
fit : Int -> Str -> Str
fit = fn width, text ->
    length = String.length text
    if width <= 0 then
        ""
    else if length > width then
        "${takeBytes (width - 1) text}…"
    else
        text ++ String.repeat (width - length) " "

takeBytes : Int -> Str -> Str
takeBytes = fn n, text ->
    Str.toUtf8 text
        |> List.take n
        |> Str.fromUtf8
        |> Result.withDefault text

{-| The text without its last character (which can take up to four bytes). -}
dropLast : Str -> Str
dropLast = fn text ->
    bytes = Str.toUtf8 text
    List.range 1 4
        |> List.filterMap (fn n -> Str.fromUtf8 (List.take (List.length bytes - n) bytes))
        |> List.head
        |> Maybe.withDefault ""

indexOf : (a -> Bool) -> List a -> Maybe Int
indexOf = fn found, xs ->
    xs
        |> List.indexedMap (fn i, x -> (i, x))
        |> List.filter (fn (_, x) -> found x)
        |> List.head
        |> Maybe.map .0
