app [main!] { pf: platform "../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Currying and data-last pipes in punkroc. -}

add : I64 -> I64 -> I64
add = fn a, b ->
    a + b

-- Partial application: `add 10` is a function that still wants one number.
addTen : I64 -> I64
addTen = add 10

-- Point-free: `List.map addTen` still wants the list.
addTenToAll : List I64 -> List I64
addTenToAll = List.map addTen

-- A function that returns a function, written as nested lambdas.
scale = fn factor -> fn x -> factor * x

-- Picking a function and calling it right away: `pick True 3 4`.
pick : Bool -> I64 -> I64 -> I64
pick = fn useAdd ->
    if useAdd then add else fn a, b -> a * b

greeting : Str -> Str -> Str
greeting = fn greet, name ->
    "${greet}, ${name}!"

main! = fn () ->
    numbers = [1, 2, 3, 4, 5]

    numbers
        |> addTenToAll
        |> List.map (scale 2)
        |> List.keepIf (fn n -> n > 24)
        |> List.map I64.toStr
        |> Str.joinWith ", "
        |> Stdout.line!

    total = List.fold add 0 numbers
    Stdout.line! "total: ${I64.toStr total}"
    Stdout.line! "pick: ${I64.toStr (pick True 3 4)} ${I64.toStr (pick False 3 4)}"

    ["Ada", "Grace"]
        |> List.map (greeting "Hello")
        |> List.forEach! Stdout.line!

    parsed = ["1", "2", "x"] |> List.map I64.fromStr |> List.map (Result.withDefault 0)
    Stdout.line! "parsed: ${Str.inspect parsed}"
