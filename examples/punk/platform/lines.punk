app [main!] { pf: platform "../../../platforms/cli/main.roc" }

import pf.Stdout
import pf.Stdin
import pf.File
import pf.Arg

{-| Reads standard input line by line and writes it, numbered, to the file
named on the command line: `lines.punk numbered.txt < input.txt`. The
platform only lets a program write a file the user named.
-}

main! = fn () ->
    case Arg.list! () of
        [path] ->
            numbered = readLines! 1 []
            case File.write! path (String.join "\n" numbered) of
                Ok {} -> Stdout.line! "wrote ${String.fromInt (List.length numbered)} lines to ${path}"
                Err (FileErr msg) -> Stdout.line! msg
        _ ->
            Stdout.line! "give me the file to write"

readLines! = fn n, acc ->
    line = Stdin.line! ()
    if line == "" then
        acc
    else
        readLines! (n + 1) (List.append "${String.fromInt n}: ${line}" acc)
