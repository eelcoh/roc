module Shape exposing (Shape(..), area, describe)

{-| A module whose type has the module's name: the functions belong to it. -}
type Shape
    = Circle F64
    | Rect F64 F64

area : Shape -> F64
area = fn shape ->
    case shape of
        Circle r -> 3.0 * r * r
        Rect w h -> w * h

describe : Shape -> Str
describe = fn shape ->
    case shape of
        Circle _ -> "circle with area ${F64.toStr (area shape)}"
        Rect _ _ -> "rectangle with area ${F64.toStr (area shape)}"
