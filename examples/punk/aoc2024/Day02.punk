app [main!] { pf: platform "../../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Advent of Code 2024, day 2: Red-Nosed Reports. -}

example =
    """
    7 6 4 2 1
    1 2 7 8 9
    9 7 6 2 1
    1 3 2 4 5
    8 6 4 4 1
    1 3 6 7 9
    """

main! = fn () ->
    reports = parse example
    Stdout.line! "Part 1: ${U64.toStr (List.countIf isSafe reports)}"
    Stdout.line! "Part 2: ${U64.toStr (List.countIf isSafeWithDampener reports)}"

parse : Str -> List (List I64)
parse = fn input ->
    input
        |> Str.splitOn "\n"
        |> List.map parseReport

parseReport : Str -> List I64
parseReport = fn line ->
    line
        |> Str.splitOn " "
        |> List.keepOks I64.fromStr

isSafe : List I64 -> Bool
isSafe = fn levels ->
    steps = differences levels
    List.all (fn d -> d >= 1 && d <= 3) steps || List.all (fn d -> d <= -1 && d >= -3) steps

differences : List I64 -> List I64
differences = fn levels ->
    List.map2 (fn a, b -> b - a) levels (List.dropFirst 1 levels)

-- A report is also safe when removing one level makes it safe
isSafeWithDampener : List I64 -> Bool
isSafeWithDampener = fn levels ->
    dampened =
        0..<(List.len levels)
            |> Range.iter
            |> List.fromIter
            |> List.any (fn i -> isSafe (List.dropAt i levels))
    isSafe levels || dampened
