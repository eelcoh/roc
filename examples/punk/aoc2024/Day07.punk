app [main!] { pf: platform "../../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Advent of Code 2024, day 7: Bridge Repair. -}

example =
    """
    190: 10 19
    3267: 81 40 27
    83: 17 5
    156: 15 6
    7290: 6 8 6 15
    161011: 16 10 13
    192: 17 8 14
    21037: 9 7 18 13
    292: 11 6 16 20
    """

type Op = Add | Mul | Concat

type alias Equation = { target : U64, numbers : List U64 }

main! = fn () ->
    equations = example |> Str.splitOn "\n" |> List.keepOks parseEquation
    Stdout.line! "Part 1: ${U64.toStr (calibration [Add, Mul] equations)}"
    Stdout.line! "Part 2: ${U64.toStr (calibration [Add, Mul, Concat] equations)}"

parseEquation : Str -> Result Equation _
parseEquation = fn line ->
    case Str.splitOn ": " line of
        [target, numbers] ->
            Ok
                { target = U64.fromStr target?
                , numbers = numbers |> Str.splitOn " " |> List.mapTry U64.fromStr?
                }
        _ -> Err (BadLine line)

calibration : List Op -> List Equation -> U64
calibration = fn ops, equations ->
    equations
        |> List.keepIf (canBeTrue ops)
        |> List.map .target
        |> List.sum

canBeTrue : List Op -> Equation -> Bool
canBeTrue = fn ops, { target, numbers } ->
    case numbers of
        [first, ..rest] -> reaches ops target first rest
        [] -> False

-- Operators go left to right, and numbers only grow, so stop once past the target
reaches : List Op -> U64 -> U64 -> List U64 -> Bool
reaches = fn ops, target, acc, numbers ->
    if acc > target then
        False
    else
        case numbers of
            [] -> acc == target
            [n, ..rest] -> List.any (fn op -> reaches ops target (apply op acc n) rest) ops

apply : Op -> U64 -> U64 -> U64
apply = fn op, a, b ->
    case op of
        Add -> a + b
        Mul -> a * b
        Concat -> a * nextPowerOfTen b + b

nextPowerOfTen : U64 -> U64
nextPowerOfTen = fn n ->
    if n < 10 then 10 else 10 * nextPowerOfTen (n // 10)
