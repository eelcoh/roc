app [main!] { pf: platform "../../../test/fx/platform/main.roc" }

import pf.Stdout
import Grid exposing (Cells, Point)

{-| Advent of Code 2024, day 4: Ceres Search. -}

example =
    """
    MMMSXXMASM
    MSAMXMSMSA
    AMXSXMAAMM
    MSAMASMSMX
    XMASAMXAMM
    XXAMMXXAMA
    SMSMSASXSS
    SAXAMASAAA
    MAMMMXMMMM
    MXMXAXMASX
    """

main! = fn () ->
    grid = Grid.parse example
    Stdout.line! "Part 1: ${U64.toStr (part1 grid)}"
    Stdout.line! "Part 2: ${U64.toStr (part2 grid)}"

directions : List Point
directions =
    [-1, 0, 1]
        |> List.joinMap (fn dr -> [-1, 0, 1] |> List.map (fn dc -> { row = dr, col = dc }))
        |> List.dropIf (fn d -> d.row == 0 && d.col == 0)

-- Count "XMAS" in every direction from every point
part1 : Cells -> U64
part1 = fn grid ->
    Grid.points grid
        |> List.joinMap (fn p -> List.map (spells grid p) directions)
        |> List.countIf (fn found -> found)

spells : Cells -> Point -> Point -> Bool
spells = fn grid, start, dir ->
    letters = List.map (fn i -> Grid.at grid (Grid.add start (Grid.scale i dir))) [0, 1, 2, 3]
    letters == Str.toUtf8 "XMAS"

-- An "A" with "MAS" on both diagonals, in either direction
part2 : Cells -> U64
part2 = fn grid ->
    Grid.points grid
        |> List.countIf (isCross grid)

isCross : Cells -> Point -> Bool
isCross = fn grid, p ->
    corner = fn dr, dc -> Grid.at grid (Grid.add p { row = dr, col = dc })
    isMs = fn pair -> pair == ['M', 'S'] || pair == ['S', 'M']
    Grid.at grid p == 'A' && isMs [corner -1 -1, corner 1 1] && isMs [corner -1 1, corner 1 -1]
