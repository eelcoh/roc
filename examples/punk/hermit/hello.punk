app [main!] { pf: platform "../../../platforms/cli/main.roc" }

import pf.Stdout
import pf.Clock
import pf.Random

{-| Says hello from inside a Hermit unikernel, and shows that the clock,
randomness and the list builtins work there. See platforms/cli/hermit.
It runs natively too, with the same output.
-}

main! = fn () ->
    Stdout.line! "Hallo vanuit een punk-unikernel!"
    squares = List.range 1 10 |> List.map (fn n -> n * n)
    Stdout.line! "Kwadraten: ${squares |> List.map String.fromInt |> String.join ", "}"
    Stdout.line! "Som: ${String.fromInt (List.sum squares)}"
    Stdout.line! "Klok na 2026: ${yesNo (Clock.now! () > 1767225600000)}"
    Stdout.line! "Twee toevalsgetallen verschillen: ${yesNo (Random.u64! () != Random.u64! ())}"

yesNo : Bool -> Str
yesNo = fn answer ->
    if answer then "ja" else "nee"
