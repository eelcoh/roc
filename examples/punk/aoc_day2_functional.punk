app [main!] { pf: platform "../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Advent of Code 2025, day 2, in a functional punkroc style.
Same answers as test/fx/aoc_day2.roc, without var, for or while.

Builtins take the value they work on last, as in Elm, so `|>` and
partial application (`invalidIds divisorsFor`) fit together.
-}

demoInput = "11-22,95-115,998-1012,1188511880-1188511890,222220-222224,1698522-1698528,446443-446449,38593856-38593862,565653-565659,824824821-824824827,2121212118-2121212124"

main! = fn () ->
    case run! () of
        Ok _ -> {}
        Err _ -> {}

run! = fn () ->
    part1Demo = solve part1Divisors demoInput?
    part2Demo = solve properDivisors demoInput?
    Stdout.line! "Part 1 (demo): ${U64.toStr part1Demo}"
    Stdout.line! "Part 2 (demo): ${U64.toStr part2Demo}"
    Ok {}

{-| Parse the ranges, find the invalid ids in each, and add up the unique ones.
`divisorsFor` decides which pattern lengths count for a number of digits.
-}
solve : (U64 -> List U64) -> Str -> Try U64 _
solve = fn divisorsFor, input ->
    ranges =
        input
            |> Str.trim
            |> Str.splitOn ","
            |> List.mapTry parseRange?

    ranges
        |> List.joinMap splitByDigitCount
        |> List.joinMap (invalidIds divisorsFor)
        |> Set.fromList
        |> Set.toList
        |> List.sum
        |> Ok

parseRange : Str -> Try (U64, U64) _
parseRange = fn rangeStr ->
    case Str.splitOn "-" rangeStr of
        [a, b] -> Ok (U64.fromStr a?, U64.fromStr b?)
        _ -> Err InvalidRangeFormat

-- Split a range into sub-ranges where all numbers have the same digit count
splitByDigitCount : (U64, U64) -> List (U64, U64)
splitByDigitCount = fn (start, end) ->
    digits = countDigits start
    if digits == countDigits end then
        [(start, end)]
    else
        boundary = U64.pow 10 digits - 1
        splitByDigitCount (boundary + 1, end)
            |> List.append (start, boundary)

countDigits : U64 -> U64
countDigits = fn n ->
    if n < 10 then 1 else 1 + countDigits (n // 10)

-- Part 1: only a slice repeated exactly twice
part1Divisors : U64 -> List U64
part1Divisors = fn digits ->
    if digits % 2 == 0 then [digits // 2] else []

-- Part 2: any pattern length that divides the number of digits
properDivisors : U64 -> List U64
properDivisors = fn n ->
    1..=(n // 2)
        |> Range.iter
        |> Iter.keepIf (isDivisorOf n)
        |> List.fromIter

isDivisorOf : U64 -> U64 -> Bool
isDivisorOf = fn n, d ->
    n % d == 0

invalidIds : (U64 -> List U64) -> (U64, U64) -> List U64
invalidIds = fn divisorsFor, (start, end) ->
    digits = countDigits start
    divisorsFor digits
        |> List.joinMap (repeating digits start end)

{-| All numbers in [start, end] made of one pattern of `len` digits repeated.
Pattern P repeated gives P * (10^digits - 1) / (10^len - 1).
-}
repeating : U64 -> U64 -> U64 -> U64 -> List U64
repeating = fn digits, start, end, len ->
    multiplier = (U64.pow 10 digits - 1) // (U64.pow 10 len - 1)
    shift = U64.pow 10 (digits - len)

    (start // shift)..=(end // shift)
        |> Range.iter
        |> Iter.map (fn pattern -> pattern * multiplier)
        |> Iter.keepIf (fn n -> start <= n && n <= end)
        |> List.fromIter
