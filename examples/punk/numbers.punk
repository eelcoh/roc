app [main!] { pf: platform "../../test/fx/platform/main.roc" }

import pf.Stdout

{-| Numbers as in Elm: dividing an integer by zero gives 0 instead of
crashing (src/punk/numbers.zig).
-}

main! = fn () ->
    Stdout.line! "7 // 2 = ${String.fromInt (7 // 2)}, -7 // 2 = ${String.fromInt (-7 // 2)}, 7 // 0 = ${String.fromInt (7 // 0)}"
    Stdout.line! "7 % 3 = ${String.fromInt (7 % 3)}, 7 % 0 = ${String.fromInt (7 % 0)}"
    Stdout.line! "modBy 3 -1 = ${String.fromInt (modBy 3 -1)}, modBy -3 5 = ${String.fromInt (modBy -3 5)}, modBy 0 7 = ${String.fromInt (modBy 0 7)}"
    Stdout.line! "remainderBy 3 -1 = ${String.fromInt (remainderBy 3 -1)}, remainderBy 0 7 = ${String.fromInt (remainderBy 0 7)}"
    Stdout.line! "U64: ${U64.toStr (List.len [1, 2, 3] // 0)}"
